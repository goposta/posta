{{ define "content" }}
<h2 style="color: #111827; font-size: 20px; line-height: 1.3; margin: 0 0 18px; font-weight: 700; letter-spacing: -0.01em;">New chat on {{ .WidgetName }}</h2>
<p style="margin: 0 0 16px;">Hi {{ .UserName }},</p>

<p style="margin: 0 0 16px;">{{ if .VisitorName }}<strong>{{ .VisitorName }}</strong>{{ else }}A visitor{{ end }}{{ if .VisitorEmail }} ({{ .VisitorEmail }}){{ end }} started a conversation{{ if .WorkspaceName }} in <strong>{{ .WorkspaceName }}</strong>{{ end }}.</p>

{{ if .Flagged }}
<div class="alert-box alert-warning" style="padding: 14px 16px; border-radius: 10px; margin: 20px 0; font-size: 14px; line-height: 1.55; background-color: #fffbeb; border: 1px solid #fde68a; color: #92400e;">
  This conversation was flagged by spam scanning (score {{ .SpamScore }}).
</div>
{{ end }}

<p style="margin: 0 0 8px; color: #6b7280; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;">First message</p>
<div style="padding: 14px 16px; border-radius: 10px; margin: 0 0 20px; font-size: 14px; line-height: 1.6; background-color: #f9fafb; border: 1px solid #eceef2; color: #111827; white-space: pre-wrap;">{{ .Body }}</div>

{{ if .PageURL }}
<p style="margin: 0 0 16px; font-size: 13px; color: #6b7280;">Started on {{ .PageURL }}</p>
{{ end }}

{{ if .ConversationURL }}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin: 28px auto;">
  <tr><td align="center" bgcolor="#7c3aed" style="border-radius: 8px;">
    <a href="{{ .ConversationURL }}" class="btn" style="display: inline-block; padding: 13px 30px; background-color: #7c3aed; color: #ffffff !important; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px; line-height: 1;">Open the chat</a>
  </td></tr>
</table>
{{ end }}
{{ end }}
