{{ define "content" }}
<h2 style="color: #111827; font-size: 20px; line-height: 1.3; margin: 0 0 18px; font-weight: 700; letter-spacing: -0.01em;">New message on {{ .FormName }}</h2>
<p style="margin: 0 0 16px;">Hi {{ .UserName }},</p>

<p style="margin: 0 0 16px;">{{ if .WorkspaceName }}<strong>{{ .WorkspaceName }}</strong> received{{ else }}You received{{ end }} a new message through the <strong>{{ .FormName }}</strong> form.</p>

{{ if .Flagged }}
<div class="alert-box alert-warning" style="padding: 14px 16px; border-radius: 10px; margin: 20px 0; font-size: 14px; line-height: 1.55; background-color: #fffbeb; border: 1px solid #fde68a; color: #92400e;">
  This message was flagged by spam scanning (score {{ .SpamScore }}). Review it before replying.
</div>
{{ end }}

<table class="stats-table" role="presentation" style="width: 100%; border-collapse: separate; border-spacing: 0; margin: 20px 0; border: 1px solid #eceef2; border-radius: 10px; overflow: hidden;">
  <tr>
    <th style="padding: 12px 16px; text-align: left; border-bottom: 1px solid #eceef2; background-color: #f9fafb; color: #6b7280; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;">Field</th>
    <th style="padding: 12px 16px; text-align: left; border-bottom: 1px solid #eceef2; background-color: #f9fafb; color: #6b7280; font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em;">Value</th>
  </tr>
  {{ range .Fields }}
  <tr>
    <td style="padding: 12px 16px; text-align: left; border-bottom: 1px solid #eceef2; font-size: 14px; color: #6b7280; font-weight: 600;">{{ .Key }}</td>
    <td style="padding: 12px 16px; text-align: left; border-bottom: 1px solid #eceef2; font-size: 14px; color: #111827;">{{ .Value }}</td>
  </tr>
  {{ end }}
</table>

{{ if .Body }}
<p style="margin: 0 0 8px; color: #6b7280; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;">Message</p>
<div style="padding: 14px 16px; border-radius: 10px; margin: 0 0 20px; font-size: 14px; line-height: 1.6; background-color: #f9fafb; border: 1px solid #eceef2; color: #111827; white-space: pre-wrap;">{{ .Body }}</div>
{{ end }}

{{ if .MessageURL }}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin: 28px auto;">
  <tr><td align="center" bgcolor="#7c3aed" style="border-radius: 8px;">
    <a href="{{ .MessageURL }}" class="btn" style="display: inline-block; padding: 13px 30px; background-color: #7c3aed; color: #ffffff !important; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px; line-height: 1;">Open and reply</a>
  </td></tr>
</table>
{{ end }}
{{ end }}
